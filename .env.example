# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- database ---------------------------------------------------------------
# The application uses the least-privilege role. Migrations use the owner role.
DATABASE_URL=postgresql+psycopg://praxis_app:praxis_app_pw@db:5432/praxis
ADMIN_DATABASE_URL=postgresql+psycopg://praxis_owner:praxis_owner_pw@db:5432/praxis
POSTGRES_PASSWORD=postgres_superuser_pw
POSTGRES_DB=praxis

# --- auth -------------------------------------------------------------------
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_value
JWT_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- providers --------------------------------------------------------------
# mock = deterministic, offline, no API key required (default). It cannot
# fabricate, which is what makes the ablation benchmark meaningful, but its
# prose is plain and it declines anything outside a small glossary.
#
# Any OpenAI-compatible endpoint works with LLM_PROVIDER=openai - only the URL,
# key and model name change. Free tiers, no card required:
#
#   Groq          console.groq.com/keys
#                 LLM_PROVIDER=openai
#                 LLM_BASE_URL=https://api.groq.com/openai/v1
#                 LLM_MODEL=llama-3.3-70b-versatile
#
#   Google Gemini aistudio.google.com/apikey
#                 LLM_PROVIDER=openai
#                 LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                 LLM_MODEL=gemini-2.0-flash
#
#   Ollama        ollama.com - runs locally, no account and no key at all
#                 LLM_PROVIDER=ollama
#                 LLM_MODEL=llama3.1
#
# Changing the model changes how answers are *worded*. It cannot change which
# claims are allowed through: the evidence gate is deterministic code, and a
# question your documents do not cover is still refused.
LLM_PROVIDER=mock
LLM_MODEL=praxis-mock-1
LLM_API_KEY=
LLM_BASE_URL=
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=praxis-hash-384
EMBEDDING_DIMENSION=384

# --- retrieval / gate -------------------------------------------------------
RETRIEVAL_TOP_K=24
RERANK_TOP_K=8
EVIDENCE_RELEVANCE_THRESHOLD=0.18
CLAIM_SUPPORT_THRESHOLD=0.40
ANSWER_CONFIDENCE_THRESHOLD=0.55

# --- frontend ---------------------------------------------------------------
VITE_API_BASE_URL=/api
