# =============================================================================
# Employee policy: leave and business-travel reimbursement.
# =============================================================================

rule R-LV-YRS "Years of service" [LV-1]
  if   joined_on(?e) = ?j
  and  today(meridian) = ?n
  then service_years(?e) = (?n - ?j) / 365
end

rule R-LV-SR "Higher annual leave entitlement" [LV-1] priority 200
  if   service_years(?e) = ?y
  and  senior_service_years(meridian) = ?s
  and  ?y >= ?s                                       otherwise "you have {y} years of service, and the higher entitlement needs {s} completed years"
  and  annual_leave_senior(meridian) = ?d
  then annual_leave_days(?e) = ?d
  because "you have {y} years of service, at least {s}, so you receive {d} days"
end

rule R-LV-BASE "Standard annual leave entitlement" [LV-1]
  if   service_years(?e) = ?y
  and  senior_service_years(meridian) = ?s
  and  ?y < ?s
  and  annual_leave_base(meridian) = ?d
  then annual_leave_days(?e) = ?d
  because "you have {y} years of service, fewer than {s}, so you receive the standard {d} days"
end

rule R-LV-ELIG "Eligibility for the higher leave entitlement" [LV-1]
  if   service_years(?e) = ?y
  and  senior_service_years(meridian) = ?s
  and  ?y >= ?s                                       otherwise "you have {y} years of service, and the higher entitlement needs {s} completed years"
  then senior_leave_eligible(?e) = true
  because "you have {y} years of service, which meets the {s}-year requirement"
end

# --- travel reimbursement --------------------------------------------------------

rule R-TRV-CAP "Per-trip cap from grade" [TRV-1]
  if   claimant(?c) = ?e
  and  grade(?e) = ?g
  and  travel_cap(?g) = ?cap
  then claim_cap(?c) = ?cap
  because "the {g} grade has a per-trip cap of {cap}"
end

rule R-TRV-E1 "Eligible trip without receipts" [TRV-2, TRV-4, TRV-5]
  if   travel_distance_km(?c) = ?km
  and  min_trip_km(meridian) = ?min
  and  ?km >= ?min                                    otherwise "the trip was {km} km, but trips must be at least {min} km to qualify" requires "the trip was at least {min} km"
  and  claimed_amount(?c) = ?a
  and  receipt_threshold(meridian) = ?rt
  and  ?a <= ?rt
  and  claim_submitted_after_days(?c) = ?sd
  and  claim_deadline_days(meridian) = ?dl
  and  ?sd <= ?dl                                     otherwise "the claim was submitted {sd} days after the trip, past the {dl}-day deadline" requires "you submit the claim within {dl} days of the trip"
  then travel_claim_eligible(?c) = true
  because "the trip is at least {min} km and the claim is small enough not to need receipts"
end

rule R-TRV-E2 "Eligible trip with receipts" [TRV-2, TRV-4, TRV-5]
  if   travel_distance_km(?c) = ?km
  and  min_trip_km(meridian) = ?min
  and  ?km >= ?min                                    otherwise "the trip was {km} km, but trips must be at least {min} km to qualify" requires "the trip was at least {min} km"
  and  claimed_amount(?c) = ?a
  and  receipt_threshold(meridian) = ?rt
  and  ?a > ?rt
  and  receipts_attached(?c) = ?rcpt
  and  ?rcpt = true                                   otherwise "receipts are required for claims above {rt}" requires "you have receipts, which are needed for claims above {rt}"
  and  claim_submitted_after_days(?c) = ?sd
  and  claim_deadline_days(meridian) = ?dl
  and  ?sd <= ?dl                                     otherwise "the claim was submitted {sd} days after the trip, past the {dl}-day deadline" requires "you submit the claim within {dl} days of the trip"
  then travel_claim_eligible(?c) = true
  because "the trip is at least {min} km, receipts are attached for a claim above {rt}, and it was submitted within {dl} days"
end

rule R-TRV-A1 "Reimbursement for public transport" [TRV-1]
  if   travel_claim_eligible(?c) = true               otherwise "the trip does not qualify for reimbursement"
  and  travel_mode(?c) = ?m
  and  ?m = "public_transport"                         requires "you travelled by train, bus, flight or taxi"
  and  claimed_amount(?c) = ?a
  and  claim_cap(?c) = ?cap
  then reimbursable_amount(?c) = min(?a, ?cap)
  because "you are reimbursed the lower of the {a} claimed and your {cap} per-trip cap"
end

rule R-TRV-A2 "Reimbursement for own-vehicle travel" [TRV-1, TRV-3]
  if   travel_claim_eligible(?c) = true               otherwise "the trip does not qualify for reimbursement"
  and  travel_mode(?c) = ?m
  and  ?m = "own_vehicle"                              requires "you drove your own vehicle"
  and  claimed_amount(?c) = ?a
  and  claim_cap(?c) = ?cap
  and  travel_distance_km(?c) = ?km
  and  mileage_rate(meridian) = ?rate
  then reimbursable_amount(?c) = min(?a, ?cap, ?km * ?rate)
  because "you are reimbursed the lowest of the {a} claimed, your {cap} cap, and the mileage allowance of {rate} per km over {km} km"
end
