__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.local
*.log
node_modules/
frontend/dist/
frontend/.vite/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
eval_reports/
!eval_reports/.gitkeep
data/uploads/
*.sqlite3
.DS_Store

# Datasets. Real data is never committed: it is large, often confidential, and
# belongs in object storage or on the ingesting machine, not in git history.
data/
datasets/
*.csv
*.tsv
*.parquet
*.jsonl
!backend/app/seed/**/*.csv
dataset_ingestion_summary.json

# The demonstration knowledge pack is authored source, not a dataset: policies,
# rules and a fictional company graph that the assistant reasons over.
!backend/data/
backend/data/*
!backend/data/meridian/
# The generated benchmark is frozen and committed: a reported result must be
# reproducible from the exact worlds and questions it was scored on.
!backend/data/benchmark_worlds/

# Downloaded neural model weights.
backend/.model_cache/

# Runtime knowledge administration: change history and the revision marker.
backend/data/meridian/.history/
backend/data/meridian/REVISION
backend/data/meridian/knowledge/zz_admin.yaml

# Model checkpoints and tokenised corpora: large binaries that the scripts
# regenerate. `artifacts/football/results/` and the manifests are kept, because
# the paper's Study II numbers are recomputed from them.
artifacts/**/*.pt
artifacts/**/*.bin
artifacts/football/_superseded/

# The evidence the paper is checked against. `*.jsonl` and `eval_reports/` above
# exclude working output; these three splits plus the Study II claim records are
# what scripts/verify_claims.py and scripts/independent_metrics.py read, so a
# clone can re-verify every published number without re-running the experiments.
!artifacts/football/eval.jsonl
!artifacts/football/results/claims.jsonl
!eval_reports/
eval_reports/*
!eval_reports/research/
eval_reports/research/*
!eval_reports/research/paper/
!eval_reports/research/confirm/
!eval_reports/research/gate-ablation-v3/
# The relevance gate's two arms. The baseline is the 1.5B run made before the gate
# existed, so both are needed to re-check that nine cases were gained and none lost.
!eval_reports/research/relevance-gate/
!eval_reports/research/qwen2.5-1.5b/
!eval_reports/research/**/*.jsonl
!eval_reports/research/**/*.json
!eval_reports/research/**/*.md

# Page previews rendered while checking layout; not deliverables.
docs/paper/preview/
